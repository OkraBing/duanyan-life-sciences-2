{
  "name": "duanyan-life-sciences",
  "version": "0.94.0",
  "private": true,
  "description": "端砚 · 生命科学 —— 干湿闭环的科研助手，单文件前端",
  "scripts": {
    "build": "node build.mjs",
    "test": "bash run_all.sh",
    "test:quick": "bash run_all.sh --quick",
    "test:workbench": "node build.mjs && node review/workbench.cjs ./index.html",
    "proxy": "node model-proxy.mjs ./index.html",
    "test:lab": "node build.mjs && node review/autonomous-lab.cjs && node review/lab-workflow.cjs ./index.html",
    "test:workspace": "node build.mjs && node review/research-workspace.cjs ./index.html",
    "test:workbench-tricky": "node build.mjs && node review/workbench-tricky.cjs ./index.html",
    "test:iteration": "node build.mjs && node review/product-iteration.cjs ./index.html",
    "test:requirements": "node review/requirements-audit.cjs",
    "test:requirements:extended": "node review/requirements-audit.cjs --extended",
    "test:tricky20": "node build.mjs && node review/tricky20.cjs",
    "test:project-fixtures": "node build.mjs && node review/project-fixtures.cjs",
    "test:components": "node build.mjs && node review/interaction-components.cjs",
    "test:visual60": "node build.mjs && node review/v60-visual.cjs",
    "test:visual-style": "node build.mjs && node review/visual-style.cjs",
    "test:attention": "node build.mjs && node review/workbench-attention.cjs",
    "test:tricky10": "node build.mjs && node review/tricky10.cjs",
    "test:tricky15": "node build.mjs && node review/tricky15.cjs",
    "test:upgrade": "node build.mjs && node review/workbench-upgrade.cjs",
    "test:dashboard": "node build.mjs && node review/workbench-reference.cjs",
    "test:new-pages": "node build.mjs && node review/new-pages-walkthrough.cjs",
    "test:edge-states": "node build.mjs && node review/tricky10-edge-states.cjs",
    "test:navigation": "node build.mjs && node review/navigation.cjs"
  },
  "devDependencies": {
    "playwright": "1.49.1"
  },
  "engines": {
    "node": ">=18"
  }
}
